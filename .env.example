# Telegram API credentials — get from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+41xxxxxxxxx

# The group to monitor — public username (e.g. my_free_stuff_group)
# or a numeric chat ID (e.g. -1001234567890) for private groups
TARGET_GROUP=my_free_stuff_group

# Gemini API key — get from https://aistudio.google.com
# Supply several comma-separated keys to rotate automatically when one
# hits its daily free-tier quota: GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=your_gemini_api_key

# Only notify if the estimated resale value is at or above this threshold (CHF)
MIN_VALUE_CHF=20
